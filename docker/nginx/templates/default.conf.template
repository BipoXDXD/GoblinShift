# Nginx interno do GoblinShift. Em produção fica atrás do proxy de borda do host, que
# termina o TLS (ADR 014); por isso o esquema original vem de X-Forwarded-Proto.
# Só o proxy de borda (IP fixo na rede edge) pode informar o esquema original; de qualquer
# outra origem, o cabeçalho é ignorado.
map $remote_addr $from_edge {
    172.31.0.2 1;
    default    0;
}
map "$from_edge:$http_x_forwarded_proto" $forwarded_proto {
    "~^1:(?<edge_proto>https?)$" $edge_proto;
    default                      $scheme;
}

# A API é resolvida pelo DNS do Docker em tempo de requisição (proxy_pass com variável), não só
# na partida: durante o rollout (deploy/rollout-api.sh) há dois containers `api`, o Nginx alterna
# entre eles e, se um recusar a conexão, tenta o outro (proxy_next_upstream padrão: error timeout,
# nunca repetindo métodos não idempotentes). O rollout espera esse `valid` antes de parar a API velha.
resolver 127.0.0.11 valid=5s ipv6=off;

server {
    listen 80 default_server;
    server_name ${GS_DOMAIN};
    server_tokens off;
    # Substitui o log `main` da imagem, que grava IP completo e query string (access-log.conf).
    access_log /var/log/nginx/access.log privacy;

    set $api http://api:8000;
    # Logo depois do rollout, o cache do resolver ainda pode apontar para o IP de uma API que
    # saiu da rede, e esse IP não recusa a conexão: ela fica pendurada. Na rede interna conectar
    # leva menos de 1 ms, então 1 s basta para desistir e tentar a outra API, sem erro ao cliente.
    proxy_connect_timeout 1s;

    # Teto padrão dos comandos JSON (docs/GoblinShiftPlan.md, 1.7).
    client_max_body_size 64k;

    location / {
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 60s;
    }

    # Envio de conteúdo (fatia 3): teto por arquivo e sem bufferizar em disco.
    location ~ ^/api/v1/uploads/[^/]+/content$ {
        client_max_body_size 256m;
        proxy_request_buffering off;
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 600s;
    }
}
