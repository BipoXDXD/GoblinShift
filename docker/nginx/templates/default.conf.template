# Nginx interno do GoblinShift: serve o build da SPA e encaminha o backend para a API
# (docs/GoblinShiftPlan.md, 2.2, 3.6 e 3.8). Em produção fica atrás do proxy de borda do host,
# que termina o TLS (ADR 014).

# IP real do cliente: só o proxy de borda (IP fixo na rede edge) pode informá-lo. A borda troca
# o X-Forwarded-For recebido da internet pelo IP de quem conectou, então o valor é um IP só. De
# qualquer outra origem o cabeçalho é ignorado e vale o IP de quem conectou. Daqui em diante
# $remote_addr é o cliente; $realip_remote_addr continua sendo quem conectou ao Nginx.
set_real_ip_from 172.31.0.2;
real_ip_header X-Forwarded-For;

# O esquema original (X-Forwarded-Proto) também só vale vindo da borda.
map $realip_remote_addr $from_edge {
    172.31.0.2 1;
    default    0;
}
map "$from_edge:$http_x_forwarded_proto" $forwarded_proto {
    "~^1:(?<edge_proto>https?)$" $edge_proto;
    default                      $scheme;
}
# HSTS só quando a borda terminou TLS: enquanto o acesso for por http e IP, não há o que fixar.
# Valor vazio faz o add_header não emitir o cabeçalho.
map $forwarded_proto $hsts {
    https   "max-age=63072000; includeSubDomains";
    default "";
}

# /auth/* (3.8): cada início de login grava uma linha em `login_state` sem autenticação. 10 por
# minuto por cliente real, com rajada de 10 para o vai e volta do login.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_status 429;

# A API é resolvida pelo DNS do Docker em tempo de requisição (proxy_pass com variável), não só
# na partida: durante o rollout (deploy/rollout-api.sh) há dois containers `api`, o Nginx alterna
# entre eles e, se um recusar a conexão, tenta o outro (proxy_next_upstream padrão: error timeout,
# nunca repetindo métodos não idempotentes). O rollout espera esse `valid` antes de parar a API velha.
resolver 127.0.0.11 valid=5s ipv6=off;

# O mime.types da imagem não conhece o GLB da abertura (ADR 030): sem isto sairia
# application/octet-stream. No contexto http, este bloco soma ao mime.types em vez de trocá-lo.
types {
    model/gltf-binary glb;
}

server {
    listen 80 default_server;
    server_name ${GS_DOMAIN};
    server_tokens off;
    root /usr/share/nginx/html;
    # Substitui o log `main` da imagem, que grava IP completo e query string (access-log.conf).
    access_log /var/log/nginx/access.log privacy;

    set $api http://api:8000;
    # Logo depois do rollout, o cache do resolver ainda pode apontar para o IP de uma API que
    # saiu da rede, e esse IP não recusa a conexão: ela fica pendurada. Na rede interna conectar
    # leva menos de 1 ms, então 1 s basta para desistir e tentar a outra API, sem erro ao cliente.
    proxy_connect_timeout 1s;

    proxy_read_timeout 60s;

    # Teto padrão dos comandos JSON (docs/GoblinShiftPlan.md, 1.7).
    client_max_body_size 64k;

    # Compressão só do que é texto (o text/html entra sempre). Imagens, GLB, fontes e ZIP já
    # chegam comprimidos. `gzip_proxied any`: a borda acrescenta Via aos pedidos, e sem isto nada
    # atrás dela seria comprimido; vale também para o JSON da API.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json application/problem+json image/svg+xml application/manifest+json;

    # SPA: arquivo existente ou o index.html, que o React Router resolve no navegador. Sem
    # cache: um deploy novo vale na próxima navegação.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control no-cache always;
        include /etc/nginx/snippets/spa-headers.conf;
    }

    # Política de divulgação de vulnerabilidades (RFC 9116, SECURITY.md). Fora do fallback da
    # SPA: o que não existir em /.well-known/ é 404, nunca o index.html. A RFC pede text/plain
    # em UTF-8, e o Nginx só declara o charset com a diretiva.
    location /.well-known/ {
        try_files $uri =404;
        charset utf-8;
        add_header Cache-Control no-cache always;
        include /etc/nginx/snippets/spa-headers.conf;
    }

    # robots.txt (e outro .txt ou .xml que vier a existir na raiz) servido de verdade; o que não
    # existir é 404, nunca o index.html com 200 (soft 404 para os buscadores).
    location ~ ^/[^/]+\.(?:txt|xml)$ {
        try_files $uri =404;
        charset utf-8;
        add_header Cache-Control no-cache always;
        include /etc/nginx/snippets/spa-headers.conf;
    }

    # Arquivos com hash no nome (build do Vite): mudam de nome a cada mudança de conteúdo. Um
    # asset ausente é 404, nunca o index.html servido como JavaScript. O cache imutável sem
    # `always` vale só para 2xx e 304: um 404 imutável ficaria um ano no navegador.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/spa-headers.conf;
    }

    # Backend. A CSP da SPA não se aplica: a API define a sua (downloads com sandbox). A
    # documentação da API (/docs, /openapi.json) é fechada em produção e não passa por aqui.
    location /api/ {
        include /etc/nginx/snippets/proxy-api.conf;
    }
    # Sondados de fora pelo monitor de uptime (3.7) e pelo scripts/check-zero-downtime.sh.
    location = /livez {
        include /etc/nginx/snippets/proxy-api.conf;
    }
    location = /readyz {
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location /auth/ {
        limit_req zone=auth burst=10 nodelay;
        error_page 429 = @auth_rate_limited;
        include /etc/nginx/snippets/proxy-api.conf;
    }
    # Mesmo formato do RATE_LIMITED da API (problem+json). Retry-After: um pedido a cada 6 s.
    location @auth_rate_limited {
        default_type application/problem+json;
        add_header Retry-After 6 always;
        add_header Strict-Transport-Security $hsts always;
        return 429 '{"type":"https://goblinshift.dev/problems/rate-limited","title":"Muitas requisições","status":429,"detail":"Muitas tentativas de autenticação; tente de novo em alguns segundos.","code":"RATE_LIMITED","request_id":"$request_id"}';
    }

    # Envio de conteúdo (fatia 3): teto por arquivo e sem bufferizar em disco.
    location ~ ^/api/v1/uploads/[^/]+/content$ {
        client_max_body_size 256m;
        proxy_request_buffering off;
        include /etc/nginx/snippets/proxy-api.conf;
        proxy_read_timeout 600s;
    }
}
