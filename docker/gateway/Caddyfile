{
 cert_issuer acme {
  disable_http_challenge
 }
 servers :443 {
  protocols h1 h2
  listener_wrappers {
   proxy_protocol {
    timeout 2s
    allow 172.16.1.6/32
    fallback_policy reject
   }
   tls
  }
 }
 servers {
  protocols h1 h2
  trusted_proxies static 172.16.1.6/32
  trusted_proxies_strict
  client_ip_headers X-Forwarded-For
 }
 # Não liga log de acesso: filtra o log padrão, onde um erro (502 num deploy) grava o pedido
 # inteiro. Igual ao formato `privacy` do Nginx (docker/nginx/templates/default.conf.template:100):
 # caminho sem a query, IP truncado e nenhum cabeçalho do pedido. Vale para os dois sites do gateway.
 log {
  format filter {
   wrap json
   request>uri regexp \?.*$ ""
   request>remote_ip ip_mask {
    ipv4 24
    ipv6 48
   }
   request>client_ip ip_mask {
    ipv4 24
    ipv6 48
   }
   request>headers delete
  }
 }
}
http://goblinshift.dev, http://stillon.tech, http://www.goblinshift.dev, http://www.stillon.tech {
 redir https://{host}{uri} 308
}
import /etc/caddy/conf.d/*.caddy
