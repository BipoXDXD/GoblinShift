{
  "name": "goblinshift-web",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "lucide-react": "1.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/culori": "4.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "axe-core": "4.14.0",
    "culori": "4.0.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "knip": "6.41.0",
    "meshoptimizer": "1.3.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "type-coverage": "2.30.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:notice-e2e": "GS_NOTICE_FILE=e2e/fixtures/notice.json vite build --outDir dist-notice",
    "budget": "node scripts/check-budget.ts",
    "provenance": "node scripts/check-provenance.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c e2e",
    "e2e:notice": "E2E_NOTICE=1 E2E_DIST_DIR=dist-notice playwright test -c e2e",
    "e2e:sabotage": "node e2e/sabotage.ts",
    "coverage": "vitest run --coverage",
    "knip": "knip",
    "type-coverage": "type-coverage -p tsconfig.app.json --strict --at-least 100 --detail",
    "generate:api": "openapi-typescript openapi/openapi.json --output src/api/schema.d.ts"
  },
  "allowScripts": {
    "fsevents": false
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
