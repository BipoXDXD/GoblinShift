# Trecho do GoblinShift na borda (ADR 014). O destino é o IP reservado ao Nginx do GoblinShift
# na rede edge (compose.prod.yaml), e não um alias: um segundo container com o mesmo alias
# dividiria o tráfego em silêncio. Com o projeto parado, a borda sobe e responde 502.

# Domínio do GoblinShift: TLS automático e http → https automático pela borda.
goblinshift.dev {
	reverse_proxy 172.31.0.4:80
}

# Acesso pelo IP (http), temporário: sai quando a aceitação e os monitores usarem o domínio.
:80 {
	reverse_proxy 172.31.0.4:80
}
