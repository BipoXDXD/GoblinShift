# Enquanto o GoblinShift não tiver domínio, o acesso pelo IP (http) vai para ele. O destino é
# o IP reservado ao Nginx do GoblinShift na rede edge (compose.prod.yaml, ADR 014), e não um
# alias: um segundo container com o mesmo alias dividiria o tráfego em silêncio. Com o projeto
# parado, a borda sobe e responde 502.
:80 {
	reverse_proxy 172.31.0.4:80 {
		# O deploy recria o Nginx (imagem nova a cada versão); enquanto ele volta, a borda tenta
		# de novo a conexão em vez de responder 502. Falha de conexão é repetida em qualquer
		# método, porque nada da requisição chegou ao Nginx.
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}
