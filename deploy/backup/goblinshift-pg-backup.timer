# Uma vez por dia, às 00h05 de Brasília, sem sorteio (docs/adr/022-backup-externo.md).
[Unit]
Description=GoblinShift: agenda o backup diário do PostgreSQL

[Timer]
OnCalendar=*-*-* 03:05:00 UTC
# Horário fixo: um sorteio poderia empurrar o backup para cima do job seguinte do host.
RandomizedDelaySec=0min
# VPS desligada no horário: roda assim que voltar.
Persistent=true

[Install]
WantedBy=timers.target
