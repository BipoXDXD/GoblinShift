# Backup diário do PostgreSQL para fora da VPS (docs/adr/022-backup-externo.md).
# Instalado pelo deploy/backup/install.sh; disparado pelo goblinshift-pg-backup.timer.
[Unit]
Description=GoblinShift: backup cifrado do PostgreSQL para o armazenamento externo
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
# Até 4 partidas em 6 h (a do timer e 3 repetições): uma falha passageira logo depois da
# atualização da plataforma (Docker reiniciando) não perde o dia, e uma falha persistente para de
# repetir. Ver ADR 022, atualização de 2026-11-28.
StartLimitIntervalSec=6h
StartLimitBurst=4

[Service]
Type=oneshot
# O usuário da aplicação já está no grupo docker (provision.sh) e só precisa do docker exec.
User=goblinshift
Group=goblinshift
Environment=BACKUP_PG_CONTAINER=goblinshift-postgres-1
EnvironmentFile=/srv/goblinshift/secrets/backup.env
# /var/lib/goblinshift-backup, só do usuário do serviço (o root lê): guarda o last-upload-ok, o
# instante do último upload bom, para a conferência do host (fora deste repositório, ainda não
# ligada; ver ADR 022).
StateDirectory=goblinshift-backup
StateDirectoryMode=0700
# Copiado pelo install.sh para um caminho do root, fora de qualquer checkout: uma versão nova só
# chega aqui quando o instalador roda de novo.
ExecStart=/usr/local/lib/goblinshift/backup/pg-backup.sh
TimeoutStartSec=1h
Restart=on-failure
RestartSec=15min
Nice=10
IOSchedulingClass=idle
UMask=0077

# Hardening, como na unit da aceitação, mas sem nenhuma capability: o serviço roda como
# goblinshift e só fala com o socket do Docker e com o S3/healthchecks.io pelo curl.
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectHome=yes
# `full`, e não `strict`: /run precisa continuar acessível para o socket do Docker.
ProtectSystem=full
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# Unix para o socket do Docker; Internet para o PUT no S3 e os pings do healthchecks.io.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
